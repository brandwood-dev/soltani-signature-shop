{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "soltani-signature-mail-cron",
  "main": "workers/mail-outbox-cron.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "vars": {
    "API_ORIGIN": "https://soltani-signature-api.onrender.com"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
